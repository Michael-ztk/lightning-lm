# 统一系统命令服务
# 服务名: /lightning/command

uint8 CMD_GET_STATUS = 0
uint8 CMD_START_MAPPING = 1
uint8 CMD_START_LOCALIZATION = 2
uint8 CMD_STOP = 3
uint8 CMD_SAVE_MAP = 4

uint8 command
string param         # 地图名称：建图/定位/保存共用，空则沿用当前地图名。路径统一为 ./data/<param>/
---
uint8 MODE_IDLE = 0
uint8 MODE_MAPPING = 1
uint8 MODE_LOCALIZING = 2

uint32 result        # 0=���功, 非0=失败
uint8 current_mode
string message
